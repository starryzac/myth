{
  "name": "bounded-funds-workspace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --dir apps/web dev:zhiyu-next",
    "build": "pnpm --dir apps/web build:zhiyu-next",
    "build:all": "pnpm --dir apps/web build && pnpm --dir apps/web build:zhiyu && pnpm --dir apps/web build:zhiyu-next",
    "types": "uv run --frozen --no-dev python scripts/generate_openapi.py"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1"
  }
}
