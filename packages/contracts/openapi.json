          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountSummary": {
        "properties": {
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation",
            "default": true
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "oldest_account_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Account Observed At"
          },
          "latest_account_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Account Observed At"
          },
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/AccountView"
            },
            "type": "array",
            "title": "Accounts"
          },
          "credit_card_bills": {
            "items": {
              "$ref": "#/components/schemas/BillView"
            },
            "type": "array",
            "title": "Credit Card Bills"
          },
          "cash_balance_cents": {
            "type": "integer",
            "title": "Cash Balance Cents"
          },
          "position_principal_cents": {
            "type": "integer",
            "title": "Position Principal Cents"
          },
          "unknown_position_principal_cents": {
            "type": "integer",
            "title": "Unknown Position Principal Cents"
          },
          "credit_card_unpaid_cents": {
            "type": "integer",
            "title": "Credit Card Unpaid Cents"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "timezone",
          "oldest_account_observed_at",
          "latest_account_observed_at",
          "accounts",
          "credit_card_bills",
          "cash_balance_cents",
          "position_principal_cents",
          "unknown_position_principal_cents",
          "credit_card_unpaid_cents"
        ],
        "title": "AccountSummary"
      },
      "AccountView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "external_ref": {
            "type": "string",
            "title": "External Ref"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "account_type": {
            "type": "string",
            "title": "Account Type"
          },
          "bank_code": {
            "type": "string",
            "title": "Bank Code"
          },
          "currency": {
            "type": "string",
            "const": "CNY",
            "title": "Currency"
          },
          "balance_cents": {
            "type": "integer",
            "title": "Balance Cents"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "external_ref",
          "name",
          "account_type",
          "bank_code",
          "currency",
          "balance_cents",
          "observed_at"
