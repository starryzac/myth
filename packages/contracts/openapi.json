        "type": "object",
        "required": [
          "id",
          "account_id",
          "source_ref",
          "evidence_id",
          "direction",
          "amount_cents",
          "balance_after_cents",
          "category",
          "counterparty_ref",
          "is_one_off",
          "category_confirmed",
          "occurred_at",
