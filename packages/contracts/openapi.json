      },
      "TransactionView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref"
          },
          "evidence_id": {
