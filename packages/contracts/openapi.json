        "title": "AccountView"
      },
      "BillView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref"
          },
          "evidence_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Id"
          },
          "statement_date": {
            "type": "string",
            "format": "date",
            "title": "Statement Date"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          },
          "total_cents": {
            "type": "integer",
            "title": "Total Cents"
          },
          "minimum_due_cents": {
            "type": "integer",
            "title": "Minimum Due Cents"
          },
          "paid_cents": {
            "type": "integer",
            "title": "Paid Cents"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "account_id",
          "source_ref",
          "evidence_id",
          "statement_date",
          "due_date",
          "total_cents",
          "minimum_due_cents",
          "paid_cents",
          "status"
        ],
        "title": "BillView"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "bounded-funds-api",
            "title": "Service",
            "default": "bounded-funds-api"
          },
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation",
            "default": true
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "PositionList": {
        "properties": {
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation",
            "default": true
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PositionView"
            },
            "type": "array",
            "title": "Items"
