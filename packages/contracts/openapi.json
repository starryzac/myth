          },
          "minimum_purchase_cents": {
            "type": "integer",
            "title": "Minimum Purchase Cents"
          },
          "lock_days": {
            "type": "integer",
            "title": "Lock Days"
          },
          "redemption_delay_days": {
            "type": "integer",
            "title": "Redemption Delay Days"
          },
          "annual_yield_bps": {
            "type": "integer",
            "title": "Annual Yield Bps"
          },
          "early_withdrawal_loss_bps": {
            "type": "integer",
            "title": "Early Withdrawal Loss Bps"
          },
          "maturity_rule": {
            "additionalProperties": true,
            "type": "object",
            "title": "Maturity Rule"
          },
          "early_withdrawal_rule": {
            "additionalProperties": true,
            "type": "object",
            "title": "Early Withdrawal Rule"
          },
          "auto_purchase_allowed": {
            "type": "boolean",
            "title": "Auto Purchase Allowed"
          },
          "auto_redeem_allowed": {
            "type": "boolean",
            "title": "Auto Redeem Allowed"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time",
            "title": "Effective From"
          },
          "effective_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Until"
          }
        },
        "type": "object",
        "required": [
          "id",
          "product_code",
          "version_number",
          "name",
          "asset_class",
          "risk_level",
          "principal_fluctuation",
          "minimum_purchase_cents",
          "lock_days",
          "redemption_delay_days",
          "annual_yield_bps",
          "early_withdrawal_loss_bps",
          "maturity_rule",
          "early_withdrawal_rule",
          "auto_purchase_allowed",
          "auto_redeem_allowed",
          "effective_from",
          "effective_until"
        ],
        "title": "ProductView"
      },
      "TransactionPage": {
        "properties": {
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation",
            "default": true
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransactionView"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
