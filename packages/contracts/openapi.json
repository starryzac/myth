            "title": "Goal Id"
          },
          "policy_version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Version Id"
          },
          "principal_cents": {
            "type": "integer",
            "title": "Principal Cents"
          },
          "accrued_yield_cents": {
            "type": "integer",
            "title": "Accrued Yield Cents"
          },
          "purchased_at": {
            "type": "string",
            "format": "date-time",
            "title": "Purchased At"
          },
          "maturity_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maturity At"
          },
          "available_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available At"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "account_id",
          "product_id",
          "goal_id",
          "policy_version_id",
          "principal_cents",
          "accrued_yield_cents",
          "purchased_at",
          "maturity_at",
          "available_at",
          "status"
        ],
        "title": "PositionView"
      },
      "ProductList": {
        "properties": {
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation",
            "default": true
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductView"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
